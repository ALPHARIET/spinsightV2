# Salin file ini menjadi .env lalu isi API key-mu.
# JANGAN beri awalan VITE_ supaya key tidak ikut terkirim ke peramban.

# Google AI Studio (gratis): https://aistudio.google.com/apikey
LLM_API_KEY=isi_api_key_di_sini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash

# Model cadangan saat model utama kena limit atau sibuk. Kuota gratis Gemini dihitung per model.
# Untuk Gemini, nilai bawaannya sudah seperti ini; kosongkan untuk mematikan.
# LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash

# Opsional: batas waktu total per permintaan (ms).
# LLM_TIMEOUT_MS=90000

# Penyedia lain yang OpenAI-compatible:
# Atria     -> LLM_BASE_URL=https://api.atria-asi.ai/v1       LLM_MODEL=Atria-Dawn-Preview   (lambat, perlu LLM_TIMEOUT_MS=240000)
# Groq      -> LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=<nama model Groq>
# OpenAI    -> LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=<nama model OpenAI>
# OpenRouter-> LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=<nama model OpenRouter>

# Database Supabase (opsional). Kosongkan untuk menyimpan data di peramban saja (localStorage).
# Ambil dari Supabase Dashboard -> Project Settings -> API (atau pasang integrasi Supabase di Vercel).
# Service role key HANYA untuk server: jangan diberi awalan VITE_ dan jangan di-commit.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key
